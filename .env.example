# Local server-only key. Copy this file to .env and replace the placeholder.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Required for LAN clients (including the Android APK) to call the API.
# Generate a random value and enter the same value in the app's server settings.
APP_API_TOKEN=""

# Optional laptop Wi-Fi address prefilled in Android server settings.
# Example: http://192.168.1.25:3000
VITE_LAPTOP_SERVER_URL=""

# APP_URL is optional for local development.
APP_URL="MY_APP_URL"
